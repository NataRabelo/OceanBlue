FLASK_ENV=production
FLASK_DEBUG=0

DATABASE_URL=postgresql+psycopg2://blueocean:troque-por-uma-senha-forte@db:5432/blueocean

SECRET_KEY=
JWT_SECRET_KEY=
JWT_SIGNING_KEY_ID=primary
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=primary
FIELD_ENCRYPTION_KEYS=

MAX_CONTENT_LENGTH=10485760
OUTBOUND_ALLOWED_HOSTS=
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
FORCE_HTTPS=true
JWT_COOKIE_CSRF_PROTECT=true
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_NETWORKS=
STORAGE_ROOT=/app/instance/storage
RUN_MIGRATIONS=false
METRICS_TOKEN=
FEATURE_BOLETO=false
FEATURE_FISCAL=false
FEATURE_EXTERNAL_PROVIDERS=false

PLATFORM_OWNER_NAME=
PLATFORM_OWNER_USER=
PLATFORM_OWNER_PASSWORD=
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# Adicione aqui as variaveis de senha de certificado fiscal configuradas no sistema.
# Exemplo de nome: SEFAZ_CERT_PASSWORD_EMPRESA_1=
