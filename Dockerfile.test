FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
WORKDIR /app
COPY requirements-dev.txt .
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-dev.txt
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN python -m playwright install --with-deps chromium && chmod -R a+rX /opt/playwright
COPY . .
RUN useradd --create-home tester && chown -R tester:tester /app
USER tester
